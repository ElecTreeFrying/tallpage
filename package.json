{
  "name": "tallpage",
  "description": "Export the current webpage, top to bottom, as PNG, PDF, HTML, or Markdown.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@angular/build": "^22.1.2",
    "@angular/compiler-cli": "^22.1.2",
    "prettier": "~3.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.0.8",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
